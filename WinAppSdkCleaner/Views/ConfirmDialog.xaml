<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinAppSdkCleaner.Views.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAppSdkCleaner.Views">

    <!-- left, top, right, bottom -->

    <Grid Margin="16,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ConfirmTextBlock" IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords"/>
        <CheckBox Grid.Row="1" Margin="0,16,0,0" Content="Do not show again in this session" Click="CheckBox_Click"/>
    </Grid>
</ContentDialog>
    