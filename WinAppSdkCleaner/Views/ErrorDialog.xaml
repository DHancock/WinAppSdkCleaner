<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinAppSdkCleaner.Views.ErrorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinAppSdkCleaner.Views">

    <!-- left, top, right, bottom -->
    
    <ScrollView ContentOrientation="Horizontal">
        <RichTextBlock x:Name="ErrorTextBlock" Margin="16,0,0,16" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/>
    </ScrollView>
</ContentDialog>
    